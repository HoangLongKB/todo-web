# Copy thành .env.local rồi điền. .env.local đã nằm trong .gitignore.
# NEXT_PUBLIC_* bị đóng cứng vào JS lúc build: đổi là phải build lại.
NEXT_PUBLIC_APP_ENV=local
# Chỉ dùng khi APP_ENV != local
NEXT_PUBLIC_API_BASE_URL=
# Lấy từ Firebase console > Project settings > Your apps > todo-web. Công khai, không phải secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=todo-lab-hoanglong.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=todo-lab-hoanglong
NEXT_PUBLIC_FIREBASE_APP_ID=

{
  "name": "todo-web",
  "version": "0.1.0",
  "description": "Todo web mô phỏng frontend công ty (dữ liệu giả)",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "echo \"chua co test frontend (diem yeu de de xuat cai tien)\" && exit 0",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.3",
    "axios": "^1.20.0",
    "firebase": "^12.19.0",
    "next": "15.4.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
